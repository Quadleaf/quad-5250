<Window x:Class="Quad5250.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quad5250.Desktop"
        Title="Quad 5250" Width="1000" Height="640" MinWidth="640" MinHeight="420"
        Background="#1e1e1e"
        Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Status">
            <Setter Property="Foreground" Value="#c8c8c8" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2d2d2d" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBox x:Name="HostBox" Width="160" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             ToolTip="Host name or IP address" KeyDown="OnHostKeyDown" />
                    <TextBox x:Name="PortBox" Width="52" Margin="0,0,6,0" VerticalContentAlignment="Center"
                             ToolTip="Telnet port" KeyDown="OnHostKeyDown" />
                    <Button x:Name="ConnectButton" Content="Connect" Click="OnConnect" />
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnect" IsEnabled="False" />
                    <CheckBox x:Name="RememberBox" Content="Remember credentials" Foreground="#e0e0e0"
                              VerticalAlignment="Center" Margin="8,0,6,0"
                              ToolTip="Save the sign-on user and password (encrypted for your Windows account) when you press Enter" />
                    <Button Content="Forget" Click="OnForget" ToolTip="Remove saved credentials for this host" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Copy screenshot" Click="OnCopyScreenshot" ToolTip="Copy the screen as an image (Ctrl+Shift+C)" />
                    <Button Content="Save screenshot…" Click="OnSaveScreenshot" ToolTip="Save the screen as a PNG (Ctrl+Shift+S)" />
                    <ComboBox x:Name="ThemeBox" Width="80" SelectionChanged="OnThemeChanged" VerticalContentAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#2d2d2d" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="ConnectionText" Style="{StaticResource Status}" Text="Disconnected" />
                <TextBlock x:Name="LockText" Style="{StaticResource Status}" Foreground="#ffd24d" FontWeight="SemiBold" />
                <TextBlock x:Name="CursorText" DockPanel.Dock="Right" Style="{StaticResource Status}" Margin="0" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Status}" Foreground="#ff8a80" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border x:Name="TerminalHost" Background="Black" Padding="10">
            <Viewbox Stretch="Uniform">
                <local:TerminalView x:Name="Terminal" />
            </Viewbox>
        </Border>
    </DockPanel>
</Window>
